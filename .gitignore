# Dependencies
node_modules/
.pnp
.pnp.js

# Production & Dev intermediate builds
dist/
dist-electron/
.vite/

# Packaging & Release Outputs
# Ignore unpacked chromium files, blockmaps, and debug configs
release/*
# Explicitly INCLUDE the exported executable .exe files
!release/*.exe
release/win-unpacked/
release/*.blockmap
release/*.yml
release/*.yaml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.local
.env.*.local

# Temporary files & Scratch
scratch/
test-*.cjs
scratch-*.cjs

# Editor directories & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
